// Cloudflare Workers configuration for the "Deploy to Cloudflare" button in the
// README. The site is fully static, so the
// Worker only serves the `dist/` folder as assets; no adapter is needed.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homepage",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Serve foo/index.html at /foo and redirect /foo/ -> /foo, so URLs match
    // trailingSlash: never and the canonical tags (no "page with redirect").
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
}
