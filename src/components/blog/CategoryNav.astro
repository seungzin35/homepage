---
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';

import { categories } from '~/navigation';
import { getBlogPermalink } from '~/utils/permalinks';

export interface Props {
  current?: string;
  class?: string;
}

const { current, class: className = '' } = Astro.props;

const items = [{ text: '전체', href: getBlogPermalink(), icon: 'tabler:layout-grid' }, ...categories];
---

<nav aria-label="카테고리" class={twMerge('flex flex-wrap justify-center gap-2', className)}>
  {
    items.map(({ text, href, icon }) => (
      <a
        href={href}
        aria-current={current === text ? 'page' : undefined}
        class:list={[
          'inline-flex items-center gap-1.5 rounded-full border px-4 py-1.5 text-sm font-medium transition',
          current === text
            ? 'border-primary bg-primary text-white'
            : 'border-gray-200 text-muted hover:border-primary hover:text-primary dark:border-slate-700 dark:text-slate-300 dark:hover:border-indigo-300 dark:hover:text-indigo-300',
        ]}
      >
        <Icon name={icon} class="h-4 w-4" />
        {text}
      </a>
    ))
  }
</nav>
