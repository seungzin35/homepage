---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { categories } from '~/navigation';

export interface Props {
  category?: string;
  /** Per-post icon; falls back to the category icon. */
  icon?: string;
  /** Post title, used when there is no coverTitle. */
  title?: string;
  /** Headline: '|' breaks lines, [brackets] color a keyword. */
  coverTitle?: string;
  /** Short line on the yellow band. */
  coverSub?: string;
  /** Kept for callers; the cover scales to its box on its own. */
  size?: 'card' | 'hero';
}

const { category, icon: postIcon, title = '', coverTitle, coverSub } = Astro.props;

// Card-news style cover: badge, big headline with colored keywords, yellow band, icon in a circle.
// Background tint per category; text colors are shared.
const TINTS: Record<string, string> = {
  스마트폰: 'from-rose-50 via-sky-50 to-sky-100',
  '윈도우·PC': 'from-sky-50 to-blue-100',
  '오류 해결': 'from-amber-50 via-sky-50 to-sky-100',
  '웹·블로그': 'from-emerald-50 via-sky-50 to-sky-100',
};
const tint = (category && TINTS[category]) || 'from-indigo-50 to-sky-100';
const icon = postIcon || categories.find(({ text }) => text === category)?.icon || 'tabler:article';

// Without a coverTitle, use the title and move a trailing "(...)" to the band.
const match = title.match(/^(.*?)\s*\(([^)]+)\)\s*$/);
const headline = coverTitle ?? (match ? match[1] : title);
const band = coverSub ?? (match ? match[2] : undefined);

let accent = 0;
const lines = headline.split('|').map((line) =>
  line
    .split(/(\[[^\]]+\])/)
    .filter(Boolean)
    .map((part) =>
      part.startsWith('[') && part.endsWith(']')
        ? { text: part.slice(1, -1), color: accent++ % 2 === 0 ? 'text-[#e8493b]' : 'text-[#2b8fd1]' }
        : { text: part, color: '' }
    )
);
const long = !coverTitle && headline.length > 14;
---

<div class:list={['cover relative h-full w-full overflow-hidden bg-gradient-to-br', tint]} aria-hidden="true">
  <div class="circle absolute flex items-center justify-center rounded-full bg-white/75">
    <Icon
      name={icon}
      class="h-[52%] w-[52%] text-[#1e3a6e] transition duration-300 group-hover:scale-110 group-hover:-rotate-6"
    />
  </div>

  <div class="relative flex h-full flex-col items-start">
    {category && <span class="badge rounded-full bg-[#e8493b] font-bold text-white">{category}</span>}
    <p
      class:list={[
        'headline font-black tracking-tight text-[#1e3a6e]',
        long ? 'headline-long line-clamp-3' : 'whitespace-nowrap',
      ]}
    >
      {
        lines.map((parts) => (
          <span class="block">
            {parts.map(({ text, color }) => (
              <span class={color}>{text}</span>
            ))}
          </span>
        ))
      }
    </p>
    {band && <span class="band bg-[#ffdf6b] font-bold text-[#1e3a6e]">{band}</span>}
    <span class="footer mt-auto font-bold text-[#2b5a96]">{SITE.name}</span>
  </div>
</div>

<style>
  /* One unit "u" that fits both the 16:9 cards and the wider post header. */
  .cover {
    container-type: size;
    --u: min(6.4cqw, 11.4cqh);
  }
  .cover > div:last-child {
    padding: calc(var(--u) * 0.85) calc(var(--u) * 1.05) calc(var(--u) * 0.7);
  }
  .badge {
    font-size: calc(var(--u) * 0.42);
    padding: calc(var(--u) * 0.16) calc(var(--u) * 0.55);
  }
  .headline {
    margin-top: calc(var(--u) * 0.45);
    font-size: var(--u);
    line-height: 1.22;
    max-width: 66%;
  }
  .headline-long {
    font-size: calc(var(--u) * 0.85);
  }
  .band {
    margin-top: calc(var(--u) * 0.4);
    font-size: calc(var(--u) * 0.42);
    padding: calc(var(--u) * 0.12) calc(var(--u) * 0.4);
  }
  .footer {
    font-size: calc(var(--u) * 0.36);
  }
  .circle {
    width: min(48cqw, 76cqh);
    aspect-ratio: 1;
    right: -4cqw;
    bottom: -14cqh;
  }
</style>
