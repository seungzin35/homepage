---
import { Icon } from 'astro-icon/components';
import { categories } from '~/navigation';

export interface Props {
  category?: string;
  /** Per-post icon; falls back to the category icon. */
  icon?: string;
  size?: 'card' | 'hero';
}

const { category, icon: postIcon, size = 'card' } = Astro.props;

// Pastel themes per category. Class names are written out in full so Tailwind can find them.
const THEMES: Record<string, { bg: string; blob: string; icon: string; chip: string }> = {
  스마트폰: {
    bg: 'from-pink-100 to-rose-50 dark:from-pink-950/60 dark:to-slate-900',
    blob: 'bg-pink-200/70 dark:bg-pink-900/40',
    icon: 'text-pink-400',
    chip: 'text-pink-500',
  },
  '윈도우·PC': {
    bg: 'from-sky-100 to-indigo-50 dark:from-sky-950/60 dark:to-slate-900',
    blob: 'bg-sky-200/70 dark:bg-sky-900/40',
    icon: 'text-sky-400',
    chip: 'text-sky-500',
  },
  '오류 해결': {
    bg: 'from-amber-100 to-orange-50 dark:from-amber-950/60 dark:to-slate-900',
    blob: 'bg-amber-200/70 dark:bg-amber-900/40',
    icon: 'text-amber-400',
    chip: 'text-amber-500',
  },
  '웹·블로그': {
    bg: 'from-emerald-100 to-teal-50 dark:from-emerald-950/60 dark:to-slate-900',
    blob: 'bg-emerald-200/70 dark:bg-emerald-900/40',
    icon: 'text-emerald-400',
    chip: 'text-emerald-500',
  },
};
const DEFAULT_THEME = {
  bg: 'from-indigo-100 to-violet-50 dark:from-indigo-950/60 dark:to-slate-900',
  blob: 'bg-indigo-200/70 dark:bg-indigo-900/40',
  icon: 'text-indigo-400',
  chip: 'text-indigo-500',
};

const theme = (category && THEMES[category]) || DEFAULT_THEME;
const icon = postIcon || categories.find(({ text }) => text === category)?.icon || 'tabler:article';
const big = size === 'hero';
---

<div class:list={['relative h-full w-full overflow-hidden bg-gradient-to-br', theme.bg]} aria-hidden="true">
  <span class:list={['absolute -left-8 -top-10 rounded-full', theme.blob, big ? 'h-56 w-56' : 'h-32 w-32']}></span>
  <span class:list={['absolute -bottom-12 -right-6 rounded-full', theme.blob, big ? 'h-64 w-64' : 'h-36 w-36']}></span>
  <span class="absolute left-[18%] top-[22%] h-2 w-2 rounded-full bg-white/90"></span>
  <span class="absolute right-[22%] top-[18%] h-3 w-3 rounded-full bg-white/80"></span>
  <span class="absolute bottom-[20%] left-[30%] h-1.5 w-1.5 rounded-full bg-white/90"></span>
  <span class:list={['absolute right-[16%] bottom-[28%] text-lg leading-none', theme.icon]}>✦</span>
  <span class:list={['absolute left-[12%] bottom-[30%] text-xs leading-none', theme.icon]}>✦</span>

  <div class="relative flex h-full w-full items-center justify-center">
    <div
      class:list={[
        'flex items-center justify-center rounded-[28%] bg-white shadow-[0_8px_24px_-6px_rgba(0,0,0,0.15)] ring-4 ring-white/60 -rotate-6 transition duration-300 group-hover:rotate-0 group-hover:scale-105 dark:bg-slate-800 dark:ring-slate-700/60',
        big ? 'h-36 w-36' : 'h-20 w-20',
      ]}
    >
      <Icon name={icon} class:list={[theme.icon, big ? 'h-20 w-20' : 'h-11 w-11']} />
    </div>
  </div>

  {
    category && (
      <span
        class:list={[
          'absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-0.5 text-xs font-bold dark:bg-slate-800/90',
          theme.chip,
        ]}
      >
        {category}
      </span>
    )
  }
</div>
