---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';
import { Icon } from 'astro-icon/components';
import { categories } from '~/navigation';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
const Wrapper = link ? 'a' : 'div';
const categoryIcon = categories.find(({ text }) => text === post.category?.title)?.icon || 'tabler:article';
---

<article
  class="group transition intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
>
  <Wrapper href={link || undefined} class="block">
    <div class="relative aspect-video overflow-hidden rounded-2xl bg-gray-100 dark:bg-slate-800 mb-4">
      {
        image ? (
          <Image
            src={image}
            class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
            widths={[400, 900]}
            width={900}
            height={506}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.title}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-indigo-50 via-white to-sky-50 dark:from-slate-800 dark:via-slate-900 dark:to-indigo-950">
            <Icon
              name={categoryIcon}
              class="h-14 w-14 text-indigo-300 transition duration-300 group-hover:scale-110 dark:text-indigo-400/60"
            />
          </div>
        )
      }
    </div>

    <div class="mb-2 flex items-center gap-2 text-sm text-muted dark:text-slate-400">
      {post.category && <span class="font-semibold text-primary dark:text-indigo-300">{post.category.title}</span>}
      {post.category && <span aria-hidden="true">·</span>}
      <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
    </div>

    <h3
      class="text-xl font-bold leading-snug mb-2 font-heading text-heading transition group-hover:text-primary dark:text-slate-200 dark:group-hover:text-indigo-300"
    >
      {post.title}
    </h3>

    {post.excerpt && <p class="text-muted dark:text-slate-400 line-clamp-2">{post.excerpt}</p>}
  </Wrapper>
</article>
