---
import { SITE } from 'astrowind:config';
---

<span
  class="self-center ml-2 rtl:ml-0 rtl:mr-2 inline-flex items-baseline gap-1 text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white"
  aria-label={SITE?.name}
>
  <span
    class="bg-gradient-to-r from-indigo-600 via-violet-500 to-pink-500 bg-clip-text font-extrabold tracking-tight text-transparent dark:from-indigo-300 dark:via-violet-300 dark:to-pink-300"
    aria-hidden="true">ZIN</span
  >
  <span aria-hidden="true">노트</span>
</span>
