---
import GameLayout from '~/components/games/GameLayout.astro';

const faqs = [
  {
    q: '왕게임은 어떻게 하나요?',
    a: '모두 몰래 번호를 하나씩 받고, 그중 한 명은 "왕"을 받습니다. 왕이 "3번이 5번 칭찬 세 가지 하기"처럼 번호로 명령하면, 해당 번호인 사람이 따릅니다. 왕은 누가 몇 번인지 모르기 때문에 누가 걸릴지 아무도 몰라요.',
  },
  {
    q: '휴대폰 하나로 어떻게 몰래 확인하나요?',
    a: '"누르고 있는 동안 보기" 버튼을 누르고 있는 동안에만 내 카드가 보이고, 손을 떼면 바로 가려집니다. 확인한 뒤 "다음 사람에게"를 누르고 폰을 넘기면 돼요.',
  },
  {
    q: '명령은 어떤 게 좋나요?',
    a: '모두가 웃고 넘길 수 있는 가벼운 명령이 좋아요. 아래 "명령 아이디어 뽑기"에 그런 명령만 모아 두었습니다. 누군가 불편해하는 명령은 왕이라도 바꾸는 게 규칙이에요.',
  },
  {
    q: '몇 명이 할 수 있나요?',
    a: '3명부터 12명까지 됩니다. 왕 1명과 나머지 인원만큼 번호(1번부터)가 만들어집니다.',
  },
];
---

<GameLayout
  slug="king"
  title="왕게임 번호 뽑기 — 휴대폰 하나로 하는 무료 왕게임"
  description="인원 수만 넣으면 휴대폰 하나를 돌려 가며 몰래 왕과 번호를 확인하는 무료 왕게임 번호 뽑기. 모두가 웃을 수 있는 명령 아이디어도 무작위로 뽑아 줍니다."
  heading="👑 왕게임 번호 뽑기"
  lead="종이 제비 없이 휴대폰 하나로. 돌아가며 몰래 내 카드를 확인하세요."
  faqs={faqs}
>
  <div slot="game" class="select-none">
    <div id="kg-setup">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-sm font-semibold text-heading dark:text-white">인원</span>
        <button type="button" class="mg-btn" id="kg-minus" aria-label="인원 줄이기">−</button>
        <strong id="kg-count" class="w-8 text-center text-lg text-heading dark:text-white">5</strong>
        <button type="button" class="mg-btn" id="kg-plus" aria-label="인원 늘리기">+</button>
        <button type="button" class="mg-btn mg-primary ml-auto" id="kg-start">🎴 카드 섞기</button>
      </div>
    </div>

    <div
      id="kg-stage"
      class="mt-5 rounded-2xl border border-gray-200 bg-indigo-50/60 p-6 text-center dark:border-slate-700 dark:bg-slate-900"
    >
      <p id="kg-turn" class="text-lg font-bold text-heading dark:text-white">인원을 정하고 "카드 섞기"를 누르세요.</p>
      <div
        id="kg-card"
        class="mx-auto mt-4 flex h-40 w-32 items-center justify-center rounded-2xl border-4 border-indigo-300 bg-white text-5xl font-black text-indigo-600 shadow dark:bg-slate-800"
        aria-live="polite"
      >
        ?
      </div>
      <div class="mt-4 flex flex-wrap justify-center gap-2">
        <button type="button" class="mg-btn" id="kg-peek" disabled>👆 누르고 있는 동안 보기</button>
        <button type="button" class="mg-btn mg-primary" id="kg-next" disabled>다음 사람에게 ➜</button>
      </div>
    </div>

    <div class="mt-5 rounded-2xl border border-gray-200 p-5 dark:border-slate-700">
      <div class="flex flex-wrap items-center gap-2">
        <p class="font-bold text-heading dark:text-white">명령 아이디어</p>
        <button type="button" class="mg-btn ml-auto" id="kg-order">🎲 명령 뽑기</button>
      </div>
      <p id="kg-order-text" class="mt-3 min-h-[1.75rem] text-lg text-heading dark:text-white" aria-live="polite">
        왕이 무슨 명령을 할지 고민되면 눌러 보세요.
      </p>
    </div>
  </div>

  <h2>사용 방법</h2>
  <ol>
    <li><strong>인원</strong>을 정하고 <strong>카드 섞기</strong>를 누릅니다.</li>
    <li>첫 번째 사람이 <strong>누르고 있는 동안 보기</strong>를 꾹 눌러 내 카드를 확인합니다. 손을 떼면 가려져요.</li>
    <li><strong>다음 사람에게</strong>를 누르고 휴대폰을 옆 사람에게 넘깁니다.</li>
    <li>모두 확인하면 왕이 "왕!"을 외치고 번호로 명령합니다. 다음 판은 다시 카드 섞기부터.</li>
  </ol>

  <h2>모두가 즐거운 왕게임 규칙</h2>
  <ul>
    <li><strong>명령은 번호로만.</strong> 왕도 누가 몇 번인지 모르는 게 이 게임의 재미입니다.</li>
    <li><strong>누군가 곤란한 명령은 바꾸기.</strong> 신체 접촉, 개인적인 질문, 돈이 드는 명령은 피하세요.</li>
    <li><strong>마시기 강요는 금지.</strong> 벌칙은 노래 한 소절, 성대모사, 칭찬하기처럼 웃고 끝나는 걸로.</li>
    <li><strong>판은 짧게.</strong> 명령 하나 끝나면 바로 다시 섞어야 분위기가 이어집니다.</li>
  </ul>
</GameLayout>

<script>
  const ORDERS = [
    'A번이 B번에게 진심 담은 칭찬 세 가지 하기',
    'A번과 B번 자리 바꾸기',
    'A번이 좋아하는 노래 한 소절 부르기',
    'A번이 B번 흉내 내기 (B번이 웃으면 성공)',
    'A번이 오늘 있었던 가장 웃긴 일 말하기',
    'A번과 B번이 가위바위보, 진 사람이 다음 판 카드 섞기',
    'A번이 동물 성대모사 하나 하기',
    'A번이 다음 판까지 존댓말 쓰기',
    'A번이 B번에게 별명 지어 주기',
    'A번이 10초 동안 아무 말도 안 하고 웃기기',
    'A번이 "요즘 빠진 것" 하나 소개하기',
    'A번과 B번이 10초 동안 눈싸움 하기',
    'A번이 B번 장점을 광고처럼 소개하기',
    'A번이 다음 판까지 말끝마다 "냥" 붙이기',
    'A번이 B번에게 어울리는 연예인 한 명 말하기',
    'A번이 오늘 모임 한 줄 평 하기',
  ];
  const $ = (id: string) => document.getElementById(id)!;
  const countEl = $('kg-count');
  const turnEl = $('kg-turn');
  const card = $('kg-card');
  const peek = $('kg-peek') as HTMLButtonElement;
  const next = $('kg-next') as HTMLButtonElement;
  const orderText = $('kg-order-text');

  let n = 5;
  let deck: string[] = [];
  let turn = -1;
  let seen = false;

  function shuffle<T>(a: T[]) {
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function setCount(v: number) {
    n = Math.min(12, Math.max(3, v));
    countEl.textContent = String(n);
  }

  function hide() {
    card.textContent = '?';
    card.style.fontSize = '';
  }

  function show() {
    if (turn < 0 || turn >= n) return;
    const v = deck[turn];
    card.textContent = v === '왕' ? '👑' : `${v}번`;
    card.style.fontSize = v === '왕' ? '4rem' : '2.6rem';
    seen = true;
    next.disabled = false;
  }

  function start() {
    deck = shuffle(['왕', ...Array.from({ length: n - 1 }, (_, i) => String(i + 1))]);
    turn = 0;
    seen = false;
    hide();
    peek.disabled = false;
    next.disabled = true;
    next.textContent = '다음 사람에게 ➜';
    turnEl.textContent = `1번째 사람 차례예요 (총 ${n}명)`;
  }

  function goNext() {
    if (!seen) return;
    hide();
    turn++;
    seen = false;
    next.disabled = true;
    if (turn >= n) {
      peek.disabled = true;
      turnEl.textContent = '모두 확인했어요! 왕은 "왕!"을 외치고 번호로 명령하세요.';
      card.textContent = '👑';
      card.style.fontSize = '4rem';
      return;
    }
    turnEl.textContent = `${turn + 1}번째 사람 차례예요 (총 ${n}명)`;
    if (turn === n - 1) next.textContent = '확인 끝 ✔';
  }

  peek.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    show();
  });
  ['pointerup', 'pointerleave', 'pointercancel'].forEach((ev) => peek.addEventListener(ev, hide));
  peek.addEventListener('contextmenu', (e) => e.preventDefault());
  // 키보드 사용자: 스페이스·엔터를 누르고 있는 동안 보기
  peek.addEventListener('keydown', (e) => {
    if (e.key === ' ' || e.key === 'Enter') {
      e.preventDefault();
      show();
    }
  });
  peek.addEventListener('keyup', hide);
  next.addEventListener('click', goNext);
  $('kg-start').addEventListener('click', start);
  $('kg-minus').addEventListener('click', () => setCount(n - 1));
  $('kg-plus').addEventListener('click', () => setCount(n + 1));
  $('kg-order').addEventListener('click', () => {
    const nums = shuffle(Array.from({ length: Math.max(2, n - 1) }, (_, i) => i + 1));
    const t = ORDERS[Math.floor(Math.random() * ORDERS.length)];
    orderText.textContent = '👑 ' + t.split('A번').join(`${nums[0]}번`).split('B번').join(`${nums[1]}번`);
  });
</script>
