---
import GameLayout from '~/components/games/GameLayout.astro';

const faqs = [
  {
    q: '중복 없이 뽑을 수 있나요?',
    a: '네. "같은 숫자 다시 안 나오게"를 켜 두면 한 번 뽑힌 숫자는 다음 뽑기에서도 빠집니다. 경품 추첨처럼 여러 번 나눠 뽑을 때 쓰세요. "처음부터 다시"를 누르면 빠진 숫자가 모두 돌아와요.',
  },
  {
    q: '한 번에 몇 개까지 뽑을 수 있나요?',
    a: '한 번에 최대 50개까지 뽑을 수 있고, 범위는 -999,999부터 999,999까지 넣을 수 있어요.',
  },
  {
    q: '결과를 믿어도 되나요?',
    a: '브라우저의 암호용 난수 함수(crypto.getRandomValues)를 써서 범위 안의 모든 숫자가 같은 확률로 나오게 했습니다. 뽑은 결과와 시간은 화면에 기록으로 남아서, 모임에서 화면을 함께 보며 추첨하기 좋아요.',
  },
];
---

<GameLayout
  slug="number-pick"
  title="랜덤 숫자 뽑기 — 번호 추첨기 (중복 없이, 범위 지정) 무료"
  description="최솟값과 최댓값을 넣으면 숫자를 무작위로 뽑아 주는 랜덤 숫자 뽑기. 중복 없이 여러 개, 정렬, 뽑은 숫자 빼고 다시 뽑기까지. 경품 추첨, 발표 순서, 자리 배치 번호 뽑기에 쓰세요."
  heading="🔟 랜덤 숫자 뽑기"
  lead="범위와 개수를 정하고 뽑기를 누르세요. 경품 추첨, 발표 순서 정하기에 쓰기 좋아요."
  faqs={faqs}
>
  <div slot="game" class="select-none">
    <div class="grid grid-cols-3 gap-2 sm:max-w-lg">
      <label class="text-sm font-semibold text-heading dark:text-white"
        >최솟값 <input id="np-min" class="mg-input mt-1" type="number" inputmode="numeric" value="1" /></label
      >
      <label class="text-sm font-semibold text-heading dark:text-white"
        >최댓값 <input id="np-max" class="mg-input mt-1" type="number" inputmode="numeric" value="100" /></label
      >
      <label class="text-sm font-semibold text-heading dark:text-white"
        >몇 개 <input
          id="np-count"
          class="mg-input mt-1"
          type="number"
          inputmode="numeric"
          value="1"
          min="1"
          max="50"
        /></label
      >
    </div>
    <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-heading dark:text-white">
      <label class="flex items-center gap-2"
        ><input type="checkbox" id="np-unique" checked /> 같은 숫자 다시 안 나오게</label
      >
      <label class="flex items-center gap-2"><input type="checkbox" id="np-sort" /> 작은 숫자부터 정렬</label>
    </div>
    <div class="mt-3 flex flex-wrap gap-2">
      <button type="button" class="mg-btn" data-preset="1,10">1~10</button>
      <button type="button" class="mg-btn" data-preset="1,30">1~30</button>
      <button type="button" class="mg-btn" data-preset="1,100">1~100</button>
      <button type="button" class="mg-btn" data-preset="1,1000">1~1000</button>
    </div>

    <div
      id="np-out"
      class="mt-5 flex min-h-[160px] flex-wrap content-center items-center justify-center gap-3 rounded-2xl border-2 border-dashed border-indigo-300 bg-indigo-50/60 p-5 dark:border-indigo-800 dark:bg-slate-900"
      aria-live="polite"
    >
      <span class="text-xl text-muted dark:text-slate-400">뽑기를 눌러 보세요</span>
    </div>
    <p id="np-msg" class="mt-2 min-h-[1.5rem] text-center text-sm text-muted dark:text-slate-400"></p>
    <div class="mt-2 flex flex-wrap justify-center gap-2">
      <button type="button" class="mg-btn mg-primary" id="np-go" style="font-size:1.2rem;padding:.8rem 2rem"
        >🎯 뽑기</button
      >
      <button type="button" class="mg-btn" id="np-copy">결과 복사</button>
      <button type="button" class="mg-btn" id="np-reset">처음부터 다시</button>
    </div>
    <ol id="np-log" class="mt-5 grid gap-1 text-sm text-muted dark:text-slate-400"></ol>
  </div>

  <h2>사용 방법</h2>
  <ol>
    <li>
      <strong>최솟값</strong>과 <strong>최댓값</strong>을 넣습니다. 자주 쓰는 범위는 아래 버튼으로 바로 고를 수 있어요.
    </li>
    <li>한 번에 뽑을 <strong>개수</strong>를 정합니다.</li>
    <li><strong>뽑기</strong>를 누르면 숫자가 잠깐 돌아가다가 결과가 나와요.</li>
    <li>"같은 숫자 다시 안 나오게"를 켜 두면, 여러 번 나눠 뽑아도 이미 나온 숫자는 다시 나오지 않아요.</li>
  </ol>

  <h2>이럴 때 쓰기 좋아요</h2>
  <ul>
    <li>
      <strong>경품 추첨.</strong> 참가자에게 번호표를 나눠 주고, 1등부터 한 명씩 뽑으세요. 뽑힌 번호는 자동으로 빠집니다.
    </li>
    <li><strong>발표·청소 순서.</strong> 출석 번호 범위를 넣고 개수를 전체 인원으로 하면 순서가 한 번에 정해져요.</li>
    <li><strong>자리 바꾸기.</strong> 자리 번호를 뽑아 한 명씩 배정하면 공정하게 자리를 바꿀 수 있어요.</li>
  </ul>
  <p>
    번호 대신 이름으로 뽑고 싶다면 <a href="/games/team">팀 나누기·제비뽑기</a>를, 내기를 정할 땐
    <a href="/games/ladder">사다리타기</a>를 써 보세요.
  </p>
</GameLayout>

<style is:global>
  .np-ball {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 4.2rem;
    height: 4.2rem;
    padding: 0 0.8rem;
    border-radius: 9999px;
    background: #4f46e5;
    color: #fff;
    font-size: 1.8rem;
    font-weight: 900;
    box-shadow: 0 3px 0 #312e81;
  }
  .np-ball.big {
    min-width: 7rem;
    height: 7rem;
    font-size: 3rem;
  }
</style>

<script>
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const inMin = $<HTMLInputElement>('np-min');
  const inMax = $<HTMLInputElement>('np-max');
  const inCount = $<HTMLInputElement>('np-count');
  const uniq = $<HTMLInputElement>('np-unique');
  const sortCb = $<HTMLInputElement>('np-sort');
  const out = $('np-out');
  const msg = $('np-msg');
  const log = $('np-log');
  const LIMIT = 999999;
  let used = new Set<number>();
  let last: number[] = [];
  let busy = false;
  let round = 0;

  function randInt(lo: number, hi: number) {
    const span = hi - lo + 1;
    const a = new Uint32Array(1);
    const limit = Math.floor(0x100000000 / span) * span;
    do crypto.getRandomValues(a);
    while (a[0] >= limit);
    return lo + (a[0] % span);
  }

  function readRange() {
    let lo = Math.round(Number(inMin.value));
    let hi = Math.round(Number(inMax.value));
    if (!Number.isFinite(lo) || !Number.isFinite(hi)) return null;
    lo = Math.max(-LIMIT, Math.min(LIMIT, lo));
    hi = Math.max(-LIMIT, Math.min(LIMIT, hi));
    if (lo > hi) [lo, hi] = [hi, lo];
    return { lo, hi };
  }

  function show(nums: number[], rolling = false) {
    out.innerHTML = '';
    for (const n of nums) {
      const s = document.createElement('span');
      s.className = 'np-ball' + (nums.length === 1 ? ' big' : '');
      if (rolling) s.style.opacity = '0.55';
      s.textContent = String(n);
      out.appendChild(s);
    }
  }

  function draw() {
    if (busy) return;
    const r = readRange();
    if (!r) {
      msg.textContent = '숫자를 바르게 넣어 주세요.';
      return;
    }
    const count = Math.max(1, Math.min(50, Math.round(Number(inCount.value)) || 1));
    inCount.value = String(count);
    const total = r.hi - r.lo + 1;
    const unique = uniq.checked;
    let left = total;
    if (unique) for (const u of used) if (u >= r.lo && u <= r.hi) left--;
    if (unique && left < count) {
      msg.textContent =
        left === 0
          ? '범위 안의 숫자를 모두 뽑았어요. "처음부터 다시"를 눌러 주세요.'
          : `남은 숫자가 ${left}개뿐이에요. 개수를 줄여 주세요.`;
      return;
    }
    const picked: number[] = [];
    const taken = new Set<number>();
    while (picked.length < count) {
      const v = randInt(r.lo, r.hi);
      if (unique && (used.has(v) || taken.has(v))) continue;
      taken.add(v);
      picked.push(v);
    }
    if (sortCb.checked) picked.sort((a, b) => a - b);
    busy = true;
    msg.textContent = '';
    let n = 0;
    const iv = setInterval(() => {
      show(
        Array.from({ length: count }, () => randInt(r.lo, r.hi)),
        true
      );
      if (++n >= 10) {
        clearInterval(iv);
        show(picked);
        if (unique) picked.forEach((p) => used.add(p));
        last = picked;
        round++;
        const li = document.createElement('li');
        const time = new Date().toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        li.textContent = `${round}회 (${time}, ${r.lo}~${r.hi}): ${picked.join(', ')}`;
        log.prepend(li);
        if (unique) msg.textContent = `이 범위에서 남은 숫자 ${left - count}개`;
        if (navigator.vibrate) navigator.vibrate(40);
        busy = false;
      }
    }, 60);
  }

  $('np-go').addEventListener('click', draw);
  $('np-reset').addEventListener('click', () => {
    used = new Set();
    last = [];
    round = 0;
    log.innerHTML = '';
    msg.textContent = '';
    out.innerHTML = '<span class="text-xl text-muted">뽑기를 눌러 보세요</span>';
  });
  $('np-copy').addEventListener('click', async () => {
    if (!last.length) return;
    try {
      await navigator.clipboard.writeText(`뽑힌 숫자: ${last.join(', ')}`);
      msg.textContent = '복사했어요.';
    } catch {
      msg.textContent = '복사가 안 되는 브라우저예요. 화면을 캡처해 주세요.';
    }
  });
  document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) =>
    b.addEventListener('click', () => {
      const [lo, hi] = b.dataset.preset!.split(',');
      inMin.value = lo;
      inMax.value = hi;
      used = new Set();
      msg.textContent = '';
    })
  );
  [inMin, inMax].forEach((el) => el.addEventListener('change', () => (msg.textContent = '')));
</script>
