---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { miniGames } from '~/data/minigames';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: '미니게임 — 설치 없이 바로 하는 무료 웹게임',
  description:
    '설치도 가입도 없이 브라우저에서 바로 하는 무료 미니게임. 컴퓨터와 두는 오목, 매일 새 문제 스도쿠, 1분 무협 게임 암기 피하기. 휴대폰과 PC 모두 됩니다.',
};
---

<Layout metadata={metadata}>
  <Breadcrumbs bar items={[{ text: '홈', href: getPermalink('/') }, { text: '미니게임' }]} />
  <section class="mx-auto max-w-3xl px-4 pb-16 pt-6 sm:px-6">
    <h1 class="font-heading text-3xl font-bold leading-tight tracking-tight text-heading md:text-4xl dark:text-white">
      🎮 미니게임
    </h1>
    <p class="mt-3 text-lg text-muted dark:text-slate-400">
      설치도 가입도 없이 바로 하는 무료 게임이에요. 휴대폰과 PC 모두 되고, 최고 기록은 내 브라우저에 저장돼요.
    </p>

    <ul class="mt-8 grid gap-4">
      {
        miniGames.map((g) => (
          <li>
            <a
              href={getPermalink(`/games/${g.slug}`)}
              class="flex items-start gap-4 rounded-2xl border border-gray-200 p-5 transition hover:border-primary dark:border-slate-800 dark:hover:border-indigo-400"
            >
              <span class="text-4xl" aria-hidden="true">
                {g.icon}
              </span>
              <span>
                <span class="block text-xl font-bold text-heading dark:text-white">{g.name}</span>
                <span class="mt-1 block text-muted dark:text-slate-400">{g.summary}</span>
                <span class="mt-2 flex flex-wrap gap-2">
                  {g.tags.map((t) => (
                    <span class="rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-semibold text-primary dark:bg-slate-800 dark:text-indigo-300">
                      {t}
                    </span>
                  ))}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="prose prose-lg mt-12 max-w-none dark:prose-invert">
      <h2>이 미니게임들은요</h2>
      <p>
        ZIN 노트를 운영하는 제가 직접 만든 게임이에요. 자바 개발자 출신이라 코드는 익숙하지만, 게임은 틈틈이 AI와 함께
        하나씩 만들고 있어요. 광고 클릭을 유도하거나 결제를 요구하는 요소는 없어요.
      </p>
      <p>
        잠깐 머리 식힐 때 한 판씩 하기 좋은 게임으로 골랐어요. 앞으로도 단순하고 시간 잘 가는 게임을 하나씩 늘려 갈게요.
        해 보시고 불편한 점이 있으면 <a href={getPermalink('/about')}>소개 페이지</a>의 메일로 알려 주세요.
      </p>
      <h2>조금 더 긴 게임을 원한다면</h2>
      <p>
        직접 만들고 있는 무협 RPG 데모 <a href="https://zinnote.itch.io/cheongseok-demo" target="_blank" rel="noopener"
          >「청석진」</a
        >과 삼국지 용병 RPG <a href="https://zinnote.itch.io/samguk-hoegwi" target="_blank" rel="noopener"
          >「삼국지 회귀」</a
        >도 브라우저에서 무료로 해 볼 수 있어요.
      </p>
    </div>
  </section>
</Layout>
