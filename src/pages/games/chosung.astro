---
import GameLayout from '~/components/games/GameLayout.astro';
import { chosungTopics, toChosung } from '~/data/chosung';

const total = chosungTopics.reduce((n, t) => n + t.words.length, 0);
const faqs = [
  {
    q: '초성 퀴즈가 뭔가요?',
    a: '낱말의 첫소리(초성)만 보여 주고 무슨 낱말인지 맞히는 퀴즈예요. 예를 들어 과일 주제에서 "ㅂㄴㄴ"는 바나나입니다.',
  },
  {
    q: '글자를 치기 어려우면요?',
    a: '"보기 4개로 풀기"를 켜면 답을 직접 치지 않고 보기 네 개 중에서 누르기만 하면 돼요. 휴대폰 자판이 익숙하지 않은 부모님이나 아이와 할 때 편합니다.',
  },
  {
    q: '같은 초성인 다른 낱말을 적었는데 틀렸대요.',
    a: '같은 주제 목록 안에 있는 낱말이면 초성이 같을 때 정답으로 인정해요(과일의 "ㅅㄱ"는 사과와 살구 모두 정답). 다만 목록에 없는 낱말은 아직 인정하지 못해요. 이런 낱말을 알려 주시면 목록에 더할게요.',
  },
  {
    q: '문제는 몇 개인가요?',
    a: `지금은 ${chosungTopics.length}개 주제, 낱말 ${total}개가 들어 있고, 한 판에 10문제씩 무작위로 나옵니다.`,
  },
];
---

<GameLayout
  slug="chosung"
  title="초성 퀴즈 — 과일·동물·음식·나라 초성 게임 무료 (보기 모드)"
  description={`초성만 보고 낱말을 맞히는 무료 초성 퀴즈. 과일, 동물, 음식, 탈것, 직업, 나라 ${chosungTopics.length}개 주제 ${total}문제. 힌트와 보기 4개 모드가 있어 아이, 부모님과 함께 하기 좋아요.`}
  heading="🔤 초성 퀴즈"
  lead="주제를 고르고, 초성만 보고 낱말을 맞혀 보세요. 한 판에 10문제입니다."
  faqs={faqs}
>
  <div slot="game" class="select-none">
    <div id="cs-topics" class="flex flex-wrap gap-2"></div>
    <label class="mt-3 flex items-center gap-2 text-heading dark:text-white">
      <input type="checkbox" id="cs-choice" /> 보기 4개로 풀기 (글자 안 치고 누르기만)
    </label>

    <div class="mt-4 flex items-center text-lg font-bold text-heading dark:text-white">
      <span id="cs-count">1 / 10</span>
      <span id="cs-topic" class="ml-3 text-base font-medium text-muted"></span>
      <span class="ml-auto">⭕ <span id="cs-score">0</span></span>
    </div>
    <div
      class="mt-2 rounded-2xl border-2 border-emerald-300 bg-emerald-50 p-6 text-center dark:border-emerald-800 dark:bg-slate-900"
    >
      <p id="cs-q" class="text-5xl font-black tracking-[0.25em] text-heading md:text-6xl dark:text-white"></p>
      <p id="cs-hint" class="mt-3 min-h-[1.75rem] text-lg text-muted dark:text-slate-400"></p>
    </div>

    <form id="cs-form" class="mt-4 flex gap-2">
      <input
        id="cs-input"
        class="mg-input"
        style="font-size:1.4rem;padding:.7rem .9rem"
        autocomplete="off"
        placeholder="정답을 적어 보세요"
        aria-label="정답 입력"
      />
      <button type="submit" class="mg-btn mg-primary shrink-0" style="font-size:1.1rem">확인</button>
    </form>
    <div id="cs-choices" class="mt-4 grid hidden grid-cols-2 gap-3"></div>

    <p id="cs-fb" class="mt-3 min-h-[2rem] text-xl font-bold" aria-live="polite"></p>
    <div class="mt-1 flex flex-wrap gap-2">
      <button type="button" class="mg-btn" id="cs-hint-btn">💡 힌트</button>
      <button type="button" class="mg-btn" id="cs-skip">모르겠어요</button>
      <button type="button" class="mg-btn mg-primary hidden" id="cs-next">다음 문제 ➜</button>
      <button type="button" class="mg-btn mg-primary hidden" id="cs-again">🔄 새 퀴즈</button>
    </div>
    <div id="cs-review" class="mt-4"></div>
  </div>

  <h2>퀴즈 방법</h2>
  <ol>
    <li>위에서 <strong>주제</strong>를 고릅니다. "전체 섞기"는 모든 주제에서 골고루 나와요.</li>
    <li>가운데 큰 글씨로 나오는 <strong>초성</strong>을 보고 낱말을 적은 뒤 확인을 누르세요.</li>
    <li>막히면 <strong>힌트</strong>를 누르세요. 누를 때마다 앞에서부터 한 글자씩 보여 줍니다.</li>
    <li>글자를 치기 어렵다면 <strong>보기 4개로 풀기</strong>를 켜고 누르기만 하면 돼요.</li>
  </ol>

  <h2>예시 문제</h2>
  <ul>
    {
      chosungTopics.map((t) => (
        <li>
          {t.icon} {t.name}: <strong>{toChosung(t.words[1])}</strong> → {t.words[1]}
        </li>
      ))
    }
  </ul>

  <h2>가족끼리 더 재미있게</h2>
  <ul>
    <li>
      <strong>한 사람이 읽어 주기.</strong> 화면을 보는 사람이 초성을 읽어 주고, 먼저 외치는 사람이 점수를 가져가요.
    </li>
    <li><strong>주제 맞히기.</strong> 주제를 말하지 않고 "전체 섞기"로 내면 훨씬 어려워집니다.</li>
    <li>
      <strong>낱말 늘리기.</strong> 아이가 아는 낱말로 직접 초성 문제를 만들어 서로 내 보세요. 받침 없는 낱말부터 시작하면
      쉬워요.
    </li>
  </ul>
</GameLayout>

<script>
  import { chosungTopics, toChosung } from '~/data/chosung';

  type Q = { word: string; topic: string; topicId: string };
  const ROUND = 10;
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const topicsBox = $('cs-topics');
  const qEl = $('cs-q');
  const hintEl = $('cs-hint');
  const form = $<HTMLFormElement>('cs-form');
  const input = $<HTMLInputElement>('cs-input');
  const choicesEl = $('cs-choices');
  const choiceCb = $<HTMLInputElement>('cs-choice');
  const fb = $('cs-fb');
  const countEl = $('cs-count');
  const topicEl = $('cs-topic');
  const scoreEl = $('cs-score');
  const hintBtn = $<HTMLButtonElement>('cs-hint-btn');
  const skipBtn = $<HTMLButtonElement>('cs-skip');
  const nextBtn = $('cs-next');
  const againBtn = $('cs-again');
  const review = $('cs-review');
  const KEY = 'zin-chosung-v1';

  let topicId = 'all';
  let list: Q[] = [];
  let idx = 0;
  let score = 0;
  let hints = 0;
  let done = false;
  let wrong: Q[] = [];
  try {
    const s = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (s) {
      if (s.topicId) topicId = s.topicId;
      choiceCb.checked = !!s.choice;
    }
  } catch {
    /* 무시 */
  }
  function save() {
    try {
      localStorage.setItem(KEY, JSON.stringify({ topicId, choice: choiceCb.checked }));
    } catch {
      /* 무시 */
    }
  }

  function shuffle<T>(a: T[]) {
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }
  const norm = (s: string) => s.replace(/\s+/g, '');

  const topicBtns: HTMLButtonElement[] = [];
  for (const t of [{ id: 'all', name: '전체 섞기', icon: '🔀' }, ...chosungTopics]) {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'mg-btn';
    b.dataset.id = t.id;
    b.textContent = `${t.icon} ${t.name}`;
    b.addEventListener('click', () => {
      topicId = t.id;
      save();
      start();
    });
    topicBtns.push(b);
    topicsBox.appendChild(b);
  }

  function start() {
    topicBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.id === topicId)));
    const pool: Q[] = [];
    for (const t of chosungTopics)
      if (topicId === 'all' || t.id === topicId)
        for (const w of t.words) pool.push({ word: w, topic: `${t.icon} ${t.name}`, topicId: t.id });
    list = shuffle(pool).slice(0, ROUND);
    idx = 0;
    score = 0;
    wrong = [];
    review.innerHTML = '';
    againBtn.classList.add('hidden');
    show();
  }

  function show() {
    const q = list[idx];
    done = false;
    hints = 0;
    countEl.textContent = `${idx + 1} / ${list.length}`;
    topicEl.textContent = q.topic;
    scoreEl.textContent = String(score);
    qEl.textContent = toChosung(q.word);
    hintEl.textContent = `${q.word.length}글자`;
    fb.textContent = '';
    input.value = '';
    input.disabled = false;
    hintBtn.disabled = false;
    skipBtn.disabled = false;
    nextBtn.classList.add('hidden');
    renderMode();
  }

  function renderMode() {
    const q = list[idx];
    const choice = choiceCb.checked;
    form.classList.toggle('hidden', choice);
    choicesEl.classList.toggle('hidden', !choice);
    if (!choice) {
      if (!done && matchMedia('(pointer:fine)').matches) input.focus();
      return;
    }
    // 같은 주제에서, 초성이 다른 낱말 3개를 보기로
    const topic = chosungTopics.find((t) => t.id === q.topicId)!;
    const cs = toChosung(q.word);
    const others = shuffle(topic.words.filter((w) => toChosung(w) !== cs)).slice(0, 3);
    choicesEl.innerHTML = '';
    for (const o of shuffle([q.word, ...others])) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'mg-key';
      b.style.fontSize = '1.5rem';
      b.textContent = o;
      b.disabled = done;
      b.addEventListener('click', () => answer(o, b));
      choicesEl.appendChild(b);
    }
  }

  function isCorrect(q: Q, a: string) {
    const v = norm(a);
    if (v === q.word) return true;
    // 같은 주제 목록 안의, 초성이 같은 다른 낱말도 정답
    const topic = chosungTopics.find((t) => t.id === q.topicId)!;
    return topic.words.includes(v) && toChosung(v) === toChosung(q.word);
  }

  function answer(a: string, btn?: HTMLButtonElement) {
    if (done) return;
    const q = list[idx];
    if (!norm(a)) return;
    const ok = isCorrect(q, a);
    if (!ok && !btn) {
      // 직접 입력은 틀려도 다시 기회
      fb.textContent = `❌ "${a.trim()}"는 아니에요. 다시 해 보세요.`;
      fb.style.color = '#dc2626';
      input.select();
      if (navigator.vibrate) navigator.vibrate(60);
      return;
    }
    finishQ(ok, btn);
  }

  function finishQ(ok: boolean, btn?: HTMLButtonElement) {
    const q = list[idx];
    done = true;
    input.disabled = true;
    hintBtn.disabled = true;
    skipBtn.disabled = true;
    choicesEl.querySelectorAll('button').forEach((b) => {
      b.disabled = true;
      if (b.textContent === q.word) {
        b.style.background = '#dcfce7';
        b.style.borderColor = '#22c55e';
        b.style.color = '#14532d';
        b.style.opacity = '1';
      }
    });
    if (ok) {
      score++;
      scoreEl.textContent = String(score);
      fb.textContent = `⭕ 정답! ${q.word}${hints ? ` (힌트 ${hints}번)` : ''}`;
      fb.style.color = '#16a34a';
    } else {
      wrong.push(q);
      if (btn) {
        btn.style.background = '#fee2e2';
        btn.style.borderColor = '#ef4444';
        btn.style.color = '#7f1d1d';
        btn.style.opacity = '1';
      }
      fb.textContent = `정답은 "${q.word}"예요.`;
      fb.style.color = '#dc2626';
    }
    qEl.textContent = q.word;
    hintEl.textContent = toChosung(q.word);
    if (idx < list.length - 1) {
      nextBtn.classList.remove('hidden');
      if (!choiceCb.checked) nextBtn.focus();
    } else finish();
  }

  function finish() {
    const msg =
      score === list.length
        ? '🏆 만점이에요!'
        : score >= 7
          ? '👏 아주 잘했어요!'
          : score >= 4
            ? '😊 좋아요!'
            : '💪 다음 판엔 더 잘할 거예요!';
    const p = document.createElement('p');
    p.className = 'mt-2 text-2xl font-black text-heading dark:text-white';
    p.textContent = `${list.length}문제 중 ${score}개 맞혔어요. ${msg}`;
    fb.appendChild(p);
    if (wrong.length) {
      review.innerHTML = `<p class="font-bold text-heading dark:text-white">다시 보기</p><p class="mt-1 text-lg text-heading dark:text-white"></p>`;
      review.lastElementChild!.textContent = wrong.map((w) => `${toChosung(w.word)} → ${w.word}`).join(' · ');
    }
    againBtn.classList.remove('hidden');
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    answer(input.value);
  });
  hintBtn.addEventListener('click', () => {
    const q = list[idx];
    if (done || hints >= q.word.length - 1) return;
    hints++;
    hintEl.textContent = `힌트: ${q.word.slice(0, hints)}${toChosung(q.word.slice(hints))}`;
    if (hints >= q.word.length - 1) hintBtn.disabled = true;
  });
  skipBtn.addEventListener('click', () => finishQ(false));
  nextBtn.addEventListener('click', () => {
    idx++;
    show();
  });
  againBtn.addEventListener('click', start);
  choiceCb.addEventListener('change', () => {
    save();
    if (!done) renderMode();
  });
  start();
</script>
