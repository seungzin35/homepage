---
import GameLayout from '~/components/games/GameLayout.astro';

const faqs = [
  {
    q: '카드 수는 어떻게 고르면 좋나요?',
    a: '처음이라면 12장(6쌍)부터 시작해 보세요. 익숙해지면 16장, 20장으로 늘리면 됩니다. 아이와 함께 할 때도 12장이 알맞아요.',
  },
  {
    q: '기록은 무엇을 기준으로 하나요?',
    a: '모든 짝을 찾을 때까지 카드를 몇 번 뒤집었는지(시도 횟수)로 기록합니다. 적을수록 잘한 거예요. 걸린 시간도 함께 보여 줍니다.',
  },
  {
    q: '그림이 매번 바뀌나요?',
    a: '네. 판마다 과일, 동물, 탈것 그림 중에서 무작위로 골라 섞습니다. 같은 자리에 같은 그림이 나오지 않아요.',
  },
  {
    q: '글씨나 카드가 작아요.',
    a: '휴대폰은 가로로 돌리면 카드가 더 커집니다. 그래도 작으면 브라우저의 글자 크기 설정이나 화면 확대(두 손가락으로 벌리기)를 써 보세요.',
  },
];
---

<GameLayout
  slug="memory"
  title="같은 그림 짝 맞추기 — 무료 기억력 카드 게임 (큰 글씨)"
  description="카드를 두 장씩 뒤집어 같은 그림을 찾는 무료 짝 맞추기 게임. 큰 카드와 쉬운 규칙으로 부모님, 아이와 함께 하기 좋은 기억력 두뇌 운동입니다."
  heading="🃏 같은 그림 짝 맞추기"
  lead="카드를 두 장씩 뒤집어 보세요. 같은 그림이면 그대로 열려 있고, 다르면 다시 덮입니다."
  faqs={faqs}
>
  <div slot="game" class="select-none">
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" class="mg-btn" data-size="12">12장</button>
      <button type="button" class="mg-btn" data-size="16">16장</button>
      <button type="button" class="mg-btn" data-size="20">20장</button>
      <span class="ml-auto text-lg font-bold text-heading dark:text-white"
        >시도 <span id="mm-tries">0</span> · <span id="mm-time">0</span>초</span
      >
    </div>
    <p id="mm-status" class="mt-3 min-h-[2rem] text-xl font-bold text-heading dark:text-white" aria-live="polite"></p>
    <div id="mm-grid" class="mm-grid mt-2"></div>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <button type="button" class="mg-btn mg-primary" id="mm-new">🔄 새 게임</button>
      <span id="mm-best" class="ml-auto text-sm text-muted dark:text-slate-400"></span>
    </div>
  </div>

  <h2>게임 방법</h2>
  <ol>
    <li>카드 수(12장, 16장, 20장)를 고릅니다.</li>
    <li>카드 한 장을 누르면 그림이 보입니다. 한 장을 더 눌러 보세요.</li>
    <li>두 장이 <strong>같은 그림</strong>이면 열린 채로 남고, 다르면 잠깐 보여 준 뒤 다시 덮입니다.</li>
    <li>모든 짝을 찾으면 끝! 시도 횟수가 적을수록 잘한 거예요.</li>
  </ol>

  <h2>잘하는 요령</h2>
  <ul>
    <li><strong>자리를 말로 기억하기.</strong> "사과는 둘째 줄 맨 끝"처럼 소리 내어 말하면 더 잘 기억납니다.</li>
    <li>
      <strong>새 카드부터 열기.</strong> 첫 장은 아직 안 본 카드를 열고, 둘째 장은 기억나는 짝을 찾아 여는 게 좋아요.
    </li>
    <li><strong>한 줄씩 차례로.</strong> 처음에는 왼쪽 위부터 차례로 열어 가면 어디를 봤는지 헷갈리지 않습니다.</li>
  </ul>

  <h2>함께 하면 더 좋아요</h2>
  <p>
    짝 맞추기는 규칙이 단순해서 어린아이부터 어르신까지 누구나 바로 할 수 있는 게임입니다. 휴대폰 하나로 가족이 번갈아
    한 판씩 하고 시도 횟수를 비교해 보세요. 할머니, 할아버지와 손주가 함께 하면 자연스럽게 대화도 늘어납니다.
  </p>
</GameLayout>

<style is:global>
  .mm-grid {
    display: grid;
    gap: 0.6rem;
    width: 100%;
    max-width: 560px;
  }
  .mm-card {
    position: relative;
    aspect-ratio: 3 / 4;
    perspective: 600px;
    touch-action: manipulation;
  }
  .mm-inner {
    position: absolute;
    inset: 0;
    transition: transform 0.3s;
    transform-style: preserve-3d;
  }
  .mm-card.up .mm-inner,
  .mm-card.done .mm-inner {
    transform: rotateY(180deg);
  }
  .mm-face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.9rem;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .mm-back {
    background: linear-gradient(135deg, #6366f1, #a855f7);
    border: 3px solid #4338ca;
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.6rem;
    font-weight: 900;
  }
  .mm-front {
    background: #fff;
    border: 3px solid #cbd5e1;
    transform: rotateY(180deg);
    font-size: clamp(2rem, 11vw, 3.4rem);
  }
  .mm-card.done .mm-front {
    border-color: #22c55e;
    background: #f0fdf4;
  }
  .dark .mm-front {
    background: #1e293b;
    border-color: #475569;
  }
  .dark .mm-card.done .mm-front {
    background: #14532d;
    border-color: #22c55e;
  }
</style>

<script>
  const SETS = [
    ['🍎', '🍌', '🍇', '🍓', '🍉', '🍑', '🍒', '🍍', '🥝', '🍊'],
    ['🐶', '🐱', '🐰', '🐻', '🐼', '🐯', '🐸', '🐵', '🐷', '🐔'],
    ['🚗', '🚌', '🚲', '✈️', '🚀', '🚂', '🚢', '🚁', '🚜', '🚒'],
  ];
  const KEY = 'zin-memory-v1';
  const $ = (id: string) => document.getElementById(id)!;
  const grid = $('mm-grid');
  const triesEl = $('mm-tries');
  const timeEl = $('mm-time');
  const statusEl = $('mm-status');
  const bestEl = $('mm-best');
  const sizeBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-size]')];

  let size = 12;
  let cards: string[] = [];
  let els: HTMLButtonElement[] = [];
  let first = -1;
  let lock = false;
  let tries = 0;
  let found = 0;
  let t0 = 0;
  let timer = 0;
  let best: Record<string, number> = {};

  try {
    const s = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (s) {
      best = s.best || {};
      if ([12, 16, 20].includes(s.size)) size = s.size;
    }
  } catch {
    /* 무시 */
  }
  function save() {
    try {
      localStorage.setItem(KEY, JSON.stringify({ best, size }));
    } catch {
      /* 무시 */
    }
  }
  function shuffle<T>(a: T[]) {
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function newGame() {
    const set = SETS[Math.floor(Math.random() * SETS.length)];
    const pics = shuffle([...set]).slice(0, size / 2);
    cards = shuffle([...pics, ...pics]);
    first = -1;
    lock = false;
    tries = 0;
    found = 0;
    clearInterval(timer);
    t0 = 0;
    triesEl.textContent = '0';
    timeEl.textContent = '0';
    statusEl.textContent = '카드를 한 장 눌러 보세요.';
    sizeBtns.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.size) === size)));
    grid.style.gridTemplateColumns = `repeat(${size === 20 ? 5 : 4}, minmax(0, 1fr))`;
    grid.innerHTML = '';
    els = cards.map((pic, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'mm-card';
      b.setAttribute('aria-label', `카드 ${i + 1}`);
      b.innerHTML = `<span class="mm-inner"><span class="mm-face mm-back">?</span><span class="mm-face mm-front">${pic}</span></span>`;
      b.addEventListener('click', () => flip(i));
      grid.appendChild(b);
      return b;
    });
    const bb = best[String(size)];
    bestEl.textContent = bb ? `${size}장 최고 기록: ${bb}번 만에 성공` : '';
    save();
  }

  function flip(i: number) {
    const el = els[i];
    if (lock || el.classList.contains('up') || el.classList.contains('done')) return;
    if (!t0) {
      t0 = performance.now();
      timer = window.setInterval(() => {
        timeEl.textContent = String(Math.floor((performance.now() - t0) / 1000));
      }, 500);
    }
    el.classList.add('up');
    el.setAttribute('aria-label', `카드 ${i + 1}: ${cards[i]}`);
    if (first < 0) {
      first = i;
      statusEl.textContent = '같은 그림을 한 장 더 찾아보세요.';
      return;
    }
    tries++;
    triesEl.textContent = String(tries);
    const a = first;
    first = -1;
    if (cards[a] === cards[i]) {
      els[a].classList.replace('up', 'done');
      el.classList.replace('up', 'done');
      found += 2;
      if (navigator.vibrate) navigator.vibrate(30);
      if (found === cards.length) return win();
      statusEl.textContent = '👍 짝을 찾았어요!';
    } else {
      lock = true;
      statusEl.textContent = '다른 그림이에요. 자리를 기억해 두세요.';
      setTimeout(() => {
        els[a].classList.remove('up');
        el.classList.remove('up');
        els[a].setAttribute('aria-label', `카드 ${a + 1}`);
        el.setAttribute('aria-label', `카드 ${i + 1}`);
        lock = false;
      }, 900);
    }
  }

  function win() {
    clearInterval(timer);
    const sec = Math.max(1, Math.round((performance.now() - t0) / 1000));
    timeEl.textContent = String(sec);
    const k = String(size);
    const record = !best[k] || tries < best[k];
    if (record) {
      best[k] = tries;
      save();
    }
    statusEl.textContent = `🎉 다 찾았어요! ${tries}번 만에, ${sec}초${record ? ' · 최고 기록!' : ''}`;
    bestEl.textContent = `${size}장 최고 기록: ${best[k]}번 만에 성공`;
  }

  sizeBtns.forEach((b) =>
    b.addEventListener('click', () => {
      size = Number(b.dataset.size);
      newGame();
    })
  );
  $('mm-new').addEventListener('click', newGame);
  newGame();
</script>
