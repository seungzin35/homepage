---
import GameLayout from '~/components/games/GameLayout.astro';

const faqs = [
  {
    q: '아픈 이빨은 어떻게 정해지나요?',
    a: '판이 시작될 때마다 이빨 중 하나를 브라우저의 난수로 고릅니다. 누를 때까지 아무도, 만든 사람도 어느 이빨인지 몰라요.',
  },
  {
    q: '이름을 꼭 넣어야 하나요?',
    a: '아니요. 비워 두면 그냥 혼자 또는 순서 없이 할 수 있어요. 이름을 넣으면 "다음 차례"를 알려 주고, 걸린 사람 이름을 크게 보여 줍니다.',
  },
  {
    q: '진동이 안 울려요.',
    a: '진동은 휴대폰 브라우저가 허용할 때만 울립니다. 아이폰 사파리는 웹페이지 진동을 지원하지 않아서 화면 효과만 나와요.',
  },
  {
    q: '이빨 수를 바꿀 수 있나요?',
    a: '8개, 12개, 16개 중에서 고를 수 있습니다. 이빨이 많을수록 한 판이 길어지고 긴장감도 오래 갑니다.',
  },
];
---

<GameLayout
  slug="croc"
  title="악어 이빨 게임 — 폰 하나로 하는 무료 복불복 게임"
  description="이빨을 하나씩 누르다 숨은 아픈 이빨을 누르면 악어가 덥석! 휴대폰 하나를 돌려 가며 하는 무료 복불복 게임. 이름을 넣으면 차례와 걸린 사람을 알려 줍니다."
  heading="🐊 악어 이빨 게임"
  lead="이빨을 하나씩 누르세요. 숨어 있는 아픈 이빨을 누르는 순간, 악어 입이 덥석 닫힙니다."
  faqs={faqs}
>
  <div slot="game" class="select-none">
    <details class="rounded-xl border border-gray-200 p-3 dark:border-slate-700">
      <summary class="cursor-pointer text-sm font-semibold text-heading dark:text-white"
        >⚙️ 참가자 이름·이빨 수 (선택)</summary
      >
      <label for="cr-names" class="mt-3 block text-sm text-muted dark:text-slate-400"
        >이름 (쉼표나 줄바꿈으로 구분, 비워 둬도 돼요)</label
      >
      <textarea id="cr-names" rows="2" class="mg-input mt-1" placeholder="예: 민준, 서연, 도윤"></textarea>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <span class="text-sm text-muted dark:text-slate-400">이빨 수</span>
        <button type="button" class="mg-btn" data-teeth="8">8개</button>
        <button type="button" class="mg-btn" data-teeth="12">12개</button>
        <button type="button" class="mg-btn" data-teeth="16">16개</button>
      </div>
    </details>

    <p
      id="cr-status"
      class="mt-4 min-h-[2rem] text-center text-xl font-bold text-heading dark:text-white"
      aria-live="polite"
    >
    </p>

    <div id="cr-wrap" class="relative mx-auto mt-2 w-full max-w-[400px]">
      <svg id="cr-svg" viewBox="0 -60 360 440" class="block w-full" role="img" aria-label="입을 벌린 악어">
        <defs>
          <clipPath id="cr-jaw-clip"><rect x="-20" y="150" width="400" height="260"></rect></clipPath>
        </defs>
        <!-- 아래턱 (위쪽 절반은 잘라서 윗머리 뒤에 숨는 부분이 없게) -->
        <g id="cr-lower" clip-path="url(#cr-jaw-clip)">
          <ellipse cx="180" cy="170" rx="168" ry="200" fill="#16a34a" stroke="#14532d" stroke-width="6"></ellipse>
          <ellipse class="mouth" cx="180" cy="170" rx="132" ry="164" fill="#f472b6"></ellipse>
          <ellipse class="mouth" cx="180" cy="230" rx="70" ry="80" fill="#ec4899"></ellipse>
          <g id="cr-teeth"></g>
        </g>
        <!-- 윗머리 -->
        <g id="cr-upper">
          <path
            d="M 6 170 C 6 40, 70 -50, 180 -50 C 290 -50, 354 40, 354 170 Z"
            fill="#22c55e"
            stroke="#14532d"
            stroke-width="6"></path>
          <g fill="#fff" stroke="#14532d" stroke-width="2">
            <polygon points="40,170 58,170 49,196"></polygon>
            <polygon points="80,170 98,170 89,198"></polygon>
            <polygon points="262,170 280,170 271,198"></polygon>
            <polygon points="302,170 320,170 311,196"></polygon>
          </g>
          <circle cx="110" cy="-6" r="34" fill="#22c55e" stroke="#14532d" stroke-width="6"></circle>
          <circle cx="250" cy="-6" r="34" fill="#22c55e" stroke="#14532d" stroke-width="6"></circle>
          <circle cx="110" cy="-6" r="20" fill="#fff"></circle>
          <circle cx="250" cy="-6" r="20" fill="#fff"></circle>
          <circle id="cr-eye-l" cx="114" cy="-2" r="10" fill="#111827"></circle>
          <circle id="cr-eye-r" cx="246" cy="-2" r="10" fill="#111827"></circle>
          <ellipse cx="160" cy="70" rx="7" ry="5" fill="#14532d"></ellipse>
          <ellipse cx="200" cy="70" rx="7" ry="5" fill="#14532d"></ellipse>
          <g fill="#15803d" opacity="0.6">
            <circle cx="70" cy="110" r="8"></circle>
            <circle cx="290" cy="110" r="8"></circle>
            <circle cx="180" cy="130" r="9"></circle>
            <circle cx="120" cy="140" r="6"></circle>
            <circle cx="240" cy="140" r="6"></circle>
          </g>
        </g>
      </svg>
    </div>

    <div class="mt-4 flex justify-center gap-2">
      <button type="button" class="mg-btn mg-primary" id="cr-reset">🔄 새 판</button>
    </div>
  </div>

  <h2>게임 방법</h2>
  <ol>
    <li>필요하면 <strong>참가자 이름</strong>을 넣습니다. 비워 둬도 됩니다.</li>
    <li>차례대로 돌아가며 <strong>악어 이빨을 하나씩</strong> 누릅니다. 누른 이빨은 쏙 들어가요.</li>
    <li>숨어 있는 <strong>아픈 이빨</strong>을 누른 사람이 걸립니다. 악어 입이 덥석 닫히고 휴대폰이 진동해요.</li>
    <li>걸린 사람이 벌칙을 하고, <strong>새 판</strong>으로 다시 시작합니다.</li>
  </ol>

  <h2>더 재미있게 하는 방법</h2>
  <ul>
    <li>
      <strong>벌칙을 먼저 정하기.</strong> 커피 사기, 노래 한 소절, 다음 판 카드 섞기처럼 미리 정해 두면 긴장감이 커집니다.
    </li>
    <li><strong>천천히 누르기.</strong> 이빨에 손가락을 올리고 2~3초 뜸을 들이면 보는 사람이 더 떨려요.</li>
    <li><strong>이빨 수 바꾸기.</strong> 인원이 많으면 16개, 짧게 여러 판 하려면 8개가 좋아요.</li>
  </ul>

  <h2>확률 이야기</h2>
  <p>
    이빨이 12개면 처음 누르는 사람이 걸릴 확률은 1/12입니다. 안전한 이빨이 하나씩 줄어들수록 다음 사람이 걸릴 확률은
    1/11, 1/10… 으로 올라가요. 그런데 판 전체로 보면 <strong>몇 번째로 누르든 걸릴 확률은 모두 똑같이 1/12</strong>
    입니다. 뒤로 갈수록 위험해 보이지만, 앞사람이 걸려서 차례가 안 올 수도 있기 때문이에요.
  </p>
</GameLayout>

<style is:global>
  #cr-teeth .tooth {
    cursor: pointer;
    transition:
      transform 0.15s,
      fill 0.15s;
    transform-box: fill-box;
    transform-origin: center;
  }
  #cr-teeth .tooth:hover {
    fill: #fefce8;
  }
  #cr-teeth .tooth.down {
    fill: #d1d5db;
    transform: scale(0.55);
    cursor: default;
  }
  #cr-teeth .tooth:focus-visible {
    outline: none;
    stroke: #4f46e5;
    stroke-width: 5;
  }
  /* 덥석: 아래턱이 윗머리 쪽으로 올라붙고 입 안이 가려진다 */
  #cr-lower {
    transform-box: view-box;
    transform-origin: 180px 168px;
    transition: transform 0.12s ease-in;
  }
  #cr-lower.shut {
    transform: scaleY(0.42);
  }
  #cr-lower .mouth,
  #cr-lower #cr-teeth {
    transition: opacity 0.08s;
  }
  #cr-lower.shut .mouth,
  #cr-lower.shut #cr-teeth {
    opacity: 0;
  }
  #cr-wrap.shake {
    animation: cr-shake 0.4s;
  }
  @keyframes cr-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    20% {
      transform: translateX(-10px);
    }
    40% {
      transform: translateX(10px);
    }
    60% {
      transform: translateX(-6px);
    }
    80% {
      transform: translateX(6px);
    }
  }
</style>

<script>
  const KEY = 'zin-croc-v1';
  const NS = 'http://www.w3.org/2000/svg';
  const $ = (id: string) => document.getElementById(id)!;
  const teethG = $('cr-teeth');
  const lower = $('cr-lower');
  const statusEl = $('cr-status');
  const wrap = $('cr-wrap');
  const namesTa = $('cr-names') as HTMLTextAreaElement;
  const teethBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-teeth]')];

  let count = 12;
  let bad = 0;
  let over = false;
  let turn = 0;
  let pressed = 0;

  function players() {
    return namesTa.value
      .split(/[\n,]/)
      .map((s) => s.trim())
      .filter(Boolean);
  }

  function save() {
    try {
      localStorage.setItem(KEY, JSON.stringify({ names: namesTa.value, count }));
    } catch {
      /* 무시 */
    }
  }

  function turnText() {
    const p = players();
    if (!p.length) return pressed === 0 ? '아무 이빨이나 눌러 보세요.' : `안전! 남은 이빨 ${count - pressed}개`;
    return `${p[turn % p.length]} 차례예요`;
  }

  function buildTeeth() {
    teethG.innerHTML = '';
    // 아래턱 안쪽 둘레(타원 아래쪽 반)를 따라 이빨을 놓는다
    const cx = 180,
      cy = 170,
      rx = 132,
      ry = 164;
    for (let i = 0; i < count; i++) {
      const th = ((8 + (164 * i) / (count - 1)) * Math.PI) / 180; // 8°~172°
      const bx = cx + rx * Math.cos(th);
      const by = cy + ry * Math.sin(th);
      // 안쪽(중심) 방향
      const dx = cx - bx,
        dy = cy - by;
      const len = Math.hypot(dx, dy);
      const ux = dx / len,
        uy = dy / len;
      const half = Math.min(22, (Math.PI * 140) / count / 2.2);
      const tip = 38;
      const p1 = [bx - uy * half, by + ux * half];
      const p2 = [bx + uy * half, by - ux * half];
      const p3 = [bx + ux * tip, by + uy * tip];
      const poly = document.createElementNS(NS, 'polygon');
      poly.setAttribute('points', [p1, p3, p2].map((p) => p.map((v) => v.toFixed(1)).join(',')).join(' '));
      poly.setAttribute('class', 'tooth');
      poly.setAttribute('fill', '#ffffff');
      poly.setAttribute('stroke', '#14532d');
      poly.setAttribute('stroke-width', '3');
      poly.setAttribute('stroke-linejoin', 'round');
      poly.setAttribute('tabindex', '0');
      poly.setAttribute('role', 'button');
      poly.setAttribute('aria-label', `이빨 ${i + 1}`);
      poly.dataset.i = String(i);
      poly.addEventListener('click', () => press(i, poly));
      poly.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
          e.preventDefault();
          press(i, poly);
        }
      });
      teethG.appendChild(poly);
    }
  }

  function press(i: number, el: SVGPolygonElement) {
    if (over || el.classList.contains('down')) return;
    if (i === bad) {
      over = true;
      lower.classList.add('shut');
      wrap.classList.remove('shake');
      void wrap.offsetWidth;
      wrap.classList.add('shake');
      if (navigator.vibrate) navigator.vibrate([200, 60, 200]);
      const p = players();
      statusEl.textContent = p.length ? `😱 ${p[turn % p.length]} 걸렸다!` : '😱 덥석! 걸렸어요!';
      return;
    }
    el.classList.add('down');
    el.setAttribute('aria-disabled', 'true');
    pressed++;
    if (navigator.vibrate) navigator.vibrate(15);
    turn++;
    statusEl.textContent = turnText();
  }

  function reset() {
    over = false;
    pressed = 0;
    turn = 0;
    bad = Math.floor(Math.random() * count);
    lower.classList.remove('shut');
    wrap.classList.remove('shake');
    buildTeeth();
    teethBtns.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.teeth) === count)));
    statusEl.textContent = turnText();
  }

  teethBtns.forEach((b) =>
    b.addEventListener('click', () => {
      count = Number(b.dataset.teeth);
      save();
      reset();
    })
  );
  namesTa.addEventListener('input', () => {
    save();
    if (!over) statusEl.textContent = turnText();
  });
  $('cr-reset').addEventListener('click', reset);

  try {
    const s = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (s) {
      namesTa.value = s.names || '';
      if ([8, 12, 16].includes(s.count)) count = s.count;
    }
  } catch {
    /* 무시 */
  }
  reset();
</script>
