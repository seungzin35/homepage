---
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';

import Grid from '~/components/blog/Grid.astro';
import Button from '~/components/ui/Button.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import { categories } from '~/navigation';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';
import { fetchPosts, findLatestPosts } from '~/utils/blog';
import favIconSvg from '~/assets/favicons/favicon.svg';

const latestPosts = await findLatestPosts({ count: 6 });
const allPosts = await fetchPosts();
const countByCategory = (name: string) => allPosts.filter((post) => post.category?.title === name).length;

const metadata = {
  title: SITE?.name,
  ignoreTitleTemplate: true,
};

// Structured data for the site and its publisher, built only from
// `src/config.yaml` (`site.name`, `site.site`, `metadata.twitter.handle`), so
// it is correct for any site made with the template. Blog posts add
// BlogPosting on their own; the FAQs widget adds FAQPage.
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- 인트로 -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 -top-40 -z-10 mx-auto h-80 max-w-3xl rounded-full bg-gradient-to-r from-indigo-200 via-sky-100 to-pink-200 opacity-60 blur-3xl dark:from-indigo-900 dark:via-slate-900 dark:to-pink-900 dark:opacity-40"
      aria-hidden="true"
    >
    </div>
    <div class="mx-auto max-w-3xl px-4 pt-20 pb-12 text-center sm:px-6 md:pt-28 md:pb-16">
      <p class="mb-4 text-sm font-semibold tracking-wide text-primary dark:text-indigo-300">IT 생활 가이드</p>
      <h1 class="font-heading text-4xl font-bold leading-tight tracking-tight text-heading md:text-6xl dark:text-white">
        헷갈리는 IT,<br />쉽게 정리해 드려요
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg text-muted md:text-xl dark:text-slate-400">
        스마트폰·PC 사용법부터 자주 겪는 오류 해결, 무료 홈페이지 만들기까지. 직접 해 보고 따라 하기 쉽게 정리합니다.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button variant="primary" href={getBlogPermalink()} icon="tabler:arrow-right">최신 글 보기</Button>
        <Button variant="secondary" href={getPermalink('/about')}>블로그 소개</Button>
      </div>
    </div>
  </section>

  <!-- 카테고리 -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 md:py-12">
    <h2 class="mb-6 font-heading text-2xl font-bold text-heading dark:text-white">카테고리</h2>
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
      {
        categories.map(({ text, description, icon, href }) => (
          <a
            href={href}
            class="group rounded-2xl border border-gray-200 p-5 transition hover:-translate-y-0.5 hover:border-primary hover:shadow-lg dark:border-slate-800 dark:hover:border-indigo-400"
          >
            <span class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-primary dark:bg-slate-800 dark:text-indigo-300">
              <Icon name={icon} class="h-5 w-5" />
            </span>
            <p class="flex items-baseline justify-between gap-2 font-bold text-heading dark:text-white">
              {text}
              <span class="text-xs font-medium text-muted dark:text-slate-400">글 {countByCategory(text)}개</span>
            </p>
            <p class="mt-1 text-sm text-muted dark:text-slate-400">{description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 최신 글 -->
  <section class="mx-auto max-w-6xl px-4 pt-8 pb-20 sm:px-6 md:pt-12">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="font-heading text-2xl font-bold text-heading dark:text-white">최신 글</h2>
      <a href={getBlogPermalink()} class="text-sm font-medium text-muted hover:text-primary dark:text-slate-400">
        전체 글 보기 →
      </a>
    </div>
    <Grid posts={latestPosts} />
  </section>
</Layout>
