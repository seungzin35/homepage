---
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';

import Grid from '~/components/blog/Grid.astro';
import Button from '~/components/ui/Button.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import { categories, gameCategories } from '~/navigation';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';
import { fetchPosts } from '~/utils/blog';
import { miniGames } from '~/data/minigames';
import favIconSvg from '~/assets/favicons/favicon.svg';

const allPosts = await fetchPosts();
const gameNames = gameCategories.map(({ text }) => text);
const isGame = (post: (typeof allPosts)[number]) => gameNames.includes(post.category?.title ?? '');
const latestPosts = allPosts.filter((post) => !isGame(post)).slice(0, 6);
// One section per game, each with its latest 3 posts.
const gameSections = gameCategories
  .map((category) => ({
    category,
    posts: allPosts.filter((post) => post.category?.title === category.text).slice(0, 3),
  }))
  .filter(({ posts }) => posts.length > 0);
// Only the wuxia game has a public demo so far.
const DEMOS: Record<string, string> = { '무협 게임': 'https://zinnote.itch.io/cheongseok-demo' };
const countByCategory = (name: string) => allPosts.filter((post) => post.category?.title === name).length;

const metadata = {
  title: `${SITE?.name} — AI로 혼자 만드는 IT·게임·웹소설 도전 기록`,
  ignoreTitleTemplate: true,
};

// Structured data for the site and its publisher, built only from
// `src/config.yaml` (`site.name`, `site.site`, `metadata.twitter.handle`), so
// it is correct for any site made with the template. Blog posts add
// BlogPosting on their own; the FAQs widget adds FAQPage.
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- 인트로 -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 -top-40 -z-10 mx-auto h-80 max-w-3xl rounded-full bg-gradient-to-r from-indigo-200 via-sky-100 to-pink-200 opacity-60 blur-3xl dark:from-indigo-900 dark:via-slate-900 dark:to-pink-900 dark:opacity-40"
      aria-hidden="true"
    >
    </div>
    <div class="mx-auto max-w-3xl px-4 pt-20 pb-12 text-center sm:px-6 md:pt-28 md:pb-16">
      <p class="mb-4 text-sm font-semibold tracking-wide text-primary dark:text-indigo-300">직장인 1인 도전 기록</p>
      <h1 class="font-heading text-4xl font-bold leading-tight tracking-tight text-heading md:text-6xl dark:text-white">
        AI와 함께,<br />혼자 만들어 봅니다
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg text-muted md:text-xl dark:text-slate-400">
        직접 겪은 스마트폰·PC 문제 해결부터 무협·삼국지 게임 개발, 웹소설 유료화 도전까지. 해 본 것만, 실제 화면과 숫자
        그대로 기록합니다.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button variant="primary" href={getBlogPermalink()} icon="tabler:arrow-right">최신 글 보기</Button>
        <Button variant="secondary" href={getPermalink('/about')}>블로그 소개</Button>
      </div>
    </div>
  </section>

  <!-- 카테고리 -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 md:py-12">
    <h2 class="mb-6 font-heading text-2xl font-bold text-heading dark:text-white">카테고리</h2>
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
      {
        categories.map(({ text, description, icon, href }) => (
          <a
            href={href}
            class="group rounded-2xl border border-gray-200 p-5 transition hover:-translate-y-0.5 hover:border-primary hover:shadow-lg dark:border-slate-800 dark:hover:border-indigo-400"
          >
            <span class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-primary dark:bg-slate-800 dark:text-indigo-300">
              <Icon name={icon} class="h-5 w-5" />
            </span>
            <p class="flex items-baseline justify-between gap-2 font-bold text-heading dark:text-white">
              {text}
              <span class="text-xs font-medium text-muted dark:text-slate-400">글 {countByCategory(text)}개</span>
            </p>
            <p class="mt-1 text-sm text-muted dark:text-slate-400">{description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 미니게임 -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 md:py-12">
    <div class="mb-6 flex items-end justify-between">
      <div>
        <h2 class="font-heading text-2xl font-bold text-heading dark:text-white">미니게임</h2>
        <p class="mt-1 text-sm text-muted dark:text-slate-400">설치 없이 바로 하는 무료 게임, 휴대폰에서도 돼요</p>
      </div>
      <a href={getPermalink('/games')} class="text-sm font-medium text-muted hover:text-primary dark:text-slate-400">
        전체 보기 →
      </a>
    </div>
    <div class="grid gap-4 sm:grid-cols-3">
      {
        miniGames
          .filter((g) => g.home)
          .map((g) => (
            <a
              href={getPermalink(`/games/${g.slug}`)}
              class="flex items-start gap-3 rounded-2xl border border-gray-200 p-5 transition hover:border-primary dark:border-slate-800 dark:hover:border-indigo-400"
            >
              <span class="text-3xl" aria-hidden="true">
                {g.icon}
              </span>
              <span>
                <span class="block font-bold text-heading dark:text-white">{g.name}</span>
                <span class="mt-1 block text-sm text-muted dark:text-slate-400">{g.summary}</span>
              </span>
            </a>
          ))
      }
    </div>
  </section>

  <!-- 최신 글 -->
  <section class="mx-auto max-w-6xl px-4 pt-8 pb-16 sm:px-6 md:pt-12">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="font-heading text-2xl font-bold text-heading dark:text-white">최신 글</h2>
      <a href={getBlogPermalink()} class="text-sm font-medium text-muted hover:text-primary dark:text-slate-400">
        전체 글 보기 →
      </a>
    </div>
    <Grid posts={latestPosts} />
  </section>

  <!-- 게임 개발기: 게임마다 한 칸 -->
  {
    gameSections.map(({ category, posts }) => (
      <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
        <div class="rounded-3xl bg-indigo-50/60 p-6 md:p-10 dark:bg-slate-900">
          <div class="mb-6 flex items-end justify-between gap-4">
            <div>
              <h2 class="font-heading text-2xl font-bold text-heading dark:text-white">{category.text} 개발기</h2>
              <p class="mt-1 text-sm text-muted dark:text-slate-400">{category.description}</p>
              {DEMOS[category.text] && (
                <a
                  href={DEMOS[category.text]}
                  target="_blank"
                  rel="noopener"
                  class="mt-3 inline-block rounded-full bg-primary px-4 py-1.5 text-sm font-medium text-white hover:opacity-90"
                >
                  🎮 데모 직접 해 보기
                </a>
              )}
            </div>
            <a
              href={category.href}
              class="shrink-0 text-sm font-medium text-muted hover:text-primary dark:text-slate-400"
            >
              전체 보기 →
            </a>
          </div>
          <Grid posts={posts} />
        </div>
      </section>
    ))
  }
</Layout>
