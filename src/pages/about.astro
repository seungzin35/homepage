---
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import { categories } from '~/navigation';
import { getBlogPermalink } from '~/utils/permalinks';

const metadata = {
  title: '소개',
  description: '이 블로그와 글쓴이를 소개합니다.',
};

// TODO: 아래 내용을 본인 소개로 바꿔 주세요.
const profile = {
  name: '글쓴이 이름',
  intro:
    '안녕하세요! 스마트폰과 PC를 쓰다가 막히는 부분, 직접 겪고 해결한 방법을 누구나 따라 할 수 있게 정리하고 있습니다.',
  email: 'hello@example.com',
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-24">
    <p class="mb-3 text-sm font-semibold tracking-wide text-primary dark:text-indigo-300">ABOUT</p>
    <h1 class="font-heading text-4xl font-bold leading-tight tracking-tight text-heading md:text-5xl dark:text-white">
      반갑습니다, {profile.name}입니다
    </h1>
    <p class="mt-6 text-lg leading-relaxed text-muted dark:text-slate-400">{profile.intro}</p>

    <div class="prose prose-lg mt-10 max-w-none dark:prose-invert">
      <h2>이 블로그에서는</h2>
      <p>관심 있는 주제를 네 가지로 나눠 꾸준히 기록하고 있어요.</p>
    </div>

    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        categories.map(({ text, description, icon, href }) => (
          <li>
            <a
              href={href}
              class="flex items-start gap-4 rounded-2xl border border-gray-200 p-5 transition hover:border-primary dark:border-slate-800 dark:hover:border-indigo-400"
            >
              <Icon name={icon} class="mt-0.5 h-6 w-6 shrink-0 text-primary dark:text-indigo-300" />
              <span>
                <span class="block font-bold text-heading dark:text-white">{text}</span>
                <span class="block text-sm text-muted dark:text-slate-400">{description}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="prose prose-lg mt-12 max-w-none dark:prose-invert">
      <h2>연락하기</h2>
      <p>
        글에 대한 의견이나 제안은 언제든 환영해요. <a href={`mailto:${profile.email}`}>{profile.email}</a> 로 메일 주세요.
      </p>
    </div>

    <div class="mt-10">
      <Button variant="primary" href={getBlogPermalink()} icon="tabler:arrow-right">글 보러 가기</Button>
    </div>
  </section>
</Layout>
