---
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import { categories } from '~/navigation';
import { getBlogPermalink } from '~/utils/permalinks';

const metadata = {
  title: '소개',
  description: '40대 아재가 서버 비용 0원으로 홈페이지 만들기에 도전한 이야기와 이 블로그를 소개합니다.',
};

const email = 'seungzin@naver.com';

const timeline = [
  {
    step: '1단계',
    title: '무료 템플릿 고르기',
    text: '디자인을 처음부터 할 자신은 없어서, 무료로 쓸 수 있는 블로그 템플릿부터 찾았습니다.',
  },
  {
    step: '2단계',
    title: 'GitHub에 올리기',
    text: '이름만 들어 봤던 GitHub에 가입하고, 홈페이지 파일을 저장소에 올렸습니다.',
  },
  {
    step: '3단계',
    title: '무료 호스팅으로 공개',
    text: 'GitHub Pages로 서버 비용 없이 누구나 볼 수 있는 주소를 만들었습니다.',
  },
  {
    step: '4단계',
    title: '글 쓰고 다듬기',
    text: '지금 이 단계입니다. 직접 겪은 IT 문제와 해결법을 하나씩 쌓아 가고 있습니다.',
  },
];
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-24">
    <p class="mb-3 text-sm font-semibold tracking-wide text-primary dark:text-indigo-300">ABOUT</p>
    <h1 class="font-heading text-4xl font-bold leading-tight tracking-tight text-heading md:text-5xl dark:text-white">
      40대 아재의<br />홈페이지 도전기
    </h1>
    <p class="mt-6 text-lg leading-relaxed text-muted dark:text-slate-400">
      안녕하세요. 마흔 넘어 처음으로 "내 홈페이지"를 만들어 보기로 한 평범한 아재입니다. 코딩은 잘 모르지만, 모르는 건
      찾아보고 물어보면서 하나씩 해 보는 중입니다.
    </p>

    <div class="prose prose-lg mt-12 max-w-none dark:prose-invert">
      <h2>왜 이 나이에 홈페이지냐고요?</h2>
      <p>
        스마트폰을 바꿀 때마다 카카오톡 대화가 날아가고, 컴퓨터가 느려지면 누군가에게 물어봐야 했습니다. 그때마다
        검색해서 해결은 했는데, 다음에 또 같은 문제가 생기면 그 방법이 기억나지 않더라고요.
      </p>
      <p>
        그래서 <strong>"내가 해결한 방법을 내 공간에 정리해 두자"</strong>는 생각으로 시작했습니다. 남이 만든 블로그
        서비스 대신, 기왕이면 내 손으로 만든 홈페이지에서요. 나중에 보니 저 같은 분들이 꽤 많을 것 같아, 누구나 따라 할
        수 있게 쉽게 쓰려고 합니다.
      </p>

      <h2>이 홈페이지는 이렇게 만들었습니다</h2>
      <p>개발자도 아닌 아재가 서버 비용 <strong>0원</strong>으로 여기까지 왔습니다.</p>
    </div>

    <ol class="mt-6 space-y-4">
      {
        timeline.map(({ step, title, text }) => (
          <li class="flex gap-4 rounded-2xl border border-gray-200 p-5 dark:border-slate-800">
            <span class="shrink-0 rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-primary h-fit dark:bg-slate-800 dark:text-indigo-300">
              {step}
            </span>
            <span>
              <span class="block font-bold text-heading dark:text-white">{title}</span>
              <span class="mt-1 block text-muted dark:text-slate-400">{text}</span>
            </span>
          </li>
        ))
      }
    </ol>

    <div class="prose prose-lg mt-12 max-w-none dark:prose-invert">
      <h2>이 블로그에서 다루는 것</h2>
      <p>
        직접 해 보고 확인한 것만 씁니다. 어려운 용어 대신, 화면에서 무엇을 누르면 되는지 순서대로 알려 드리는 게
        목표입니다.
      </p>
    </div>

    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        categories.map(({ text, description, icon, href }) => (
          <li>
            <a
              href={href}
              class="flex h-full items-start gap-4 rounded-2xl border border-gray-200 p-5 transition hover:border-primary dark:border-slate-800 dark:hover:border-indigo-400"
            >
              <Icon name={icon} class="mt-0.5 h-6 w-6 shrink-0 text-primary dark:text-indigo-300" />
              <span>
                <span class="block font-bold text-heading dark:text-white">{text}</span>
                <span class="block text-sm text-muted dark:text-slate-400">{description}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="prose prose-lg mt-12 max-w-none dark:prose-invert">
      <h2>하나 더, 아재의 꿈</h2>
      <p>
        어릴 적 밤새 읽던 무협지를 기억하시나요? 그 감성을 담은 <strong>오프라인 무협 RPG</strong>를 직접 만들고
        있습니다. 객잔 점소이가 강호로 나서는 이야기인데, 만드는 과정은{' '}
        <a href={categories.find((category) => category.isGame)?.href}>무협 게임</a> 메뉴에 차곡차곡 기록하고 있어요. 첫 데모는
        <a href="https://zinnote.itch.io/cheongseok-demo" target="_blank" rel="noopener">itch.io</a>에서 무료로 해 볼 수
        있어요.
      </p>

      <h2>앞으로의 목표</h2>
      <ul>
        <li>도움이 되는 글을 꾸준히 쌓기</li>
        <li>내 이름으로 된 도메인 연결하기</li>
        <li>무협 게임을 휴대폰 앱으로 출시하기</li>
      </ul>
      <p>늦게 시작했지만, 천천히 끝까지 가 보겠습니다. 같이 지켜봐 주세요.</p>

      <h2>연락하기</h2>
      <p>
        글에 틀린 내용이 있거나 다뤄 줬으면 하는 주제가 있다면 편하게 알려 주세요.{' '}
        <a href={`mailto:${email}`}>{email}</a>
      </p>
    </div>

    <div class="mt-10">
      <Button variant="primary" href={getBlogPermalink()} icon="tabler:arrow-right">글 보러 가기</Button>
    </div>
  </section>
</Layout>
